# SentinelAI Phase 5 settings. Copy to .env (git-ignored) or set in your shell.
# Never commit real values. The code reads these from the environment only.

# LLM provider: template (offline, no LLM, default) | anthropic
SENTINEL_LLM_PROVIDER=template
# Required only when SENTINEL_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SENTINEL_ANTHROPIC_MODEL=claude-opus-5-5
SENTINEL_EFFORT=medium

# Embeddings: minilm (local sentence-transformers model) | hash (offline, for tests)
SENTINEL_EMBEDDER=minilm
SENTINEL_EMBED_DIM=384
SENTINEL_TOP_K=6

# PostgreSQL + pgvector. Leave empty to use the in-memory store.
# Example for the docker-compose.yml database: postgresql://sentinel:<password>@localhost:5432/sentinel
DATABASE_URL=
# Used only by docker-compose.yml
POSTGRES_PASSWORD=

# Phase 6 API (scripts/serve_phase6.py). No login: keep the host on 127.0.0.1.
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000
# Browser origins allowed to call the API (the Vite dev server)
SENTINEL_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINEL_API_MAX_QUESTION=500
